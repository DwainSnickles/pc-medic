<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PC_Medic</RootNamespace>
    <Version>1.3.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>pcmedic.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.3" />
  </ItemGroup>

  <!-- Build the companion from source and host its form inside the console. The project lives in
       its own repo, so CI passes the checkout it fetched instead of the sibling folder. -->
  <PropertyGroup>
    <DiskDefragProject Condition="'$(DiskDefragProject)' == ''">..\DiskDefrag\DiskDefrag.csproj</DiskDefragProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(DiskDefragProject)')">
    <ProjectReference Include="$(DiskDefragProject)" />
  </ItemGroup>

  <Target Name="RequireDiskDefrag" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(DiskDefragProject)')"
           Text="Disk Defrag project not found at '$(DiskDefragProject)'. Clone it beside this repo or pass -p:DiskDefragProject=&lt;path&gt;." />
  </Target>

  <!-- Disk Defrag is a separate project living in its own folder. -->
  <ItemGroup>
    <Compile Remove="DiskDefrag\**" />
    <EmbeddedResource Remove="DiskDefrag\**" />
    <None Remove="DiskDefrag\**" />
  </ItemGroup>

  <!-- Ship the Disk Defrag build that sits beside this project, so the companion is never a stale copy. -->
  <Target Name="SyncDiskDefrag" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.exe')">
    <ItemGroup>
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.exe" />
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.dll" />
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.pdb" />
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.deps.json" />
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.runtimeconfig.json" />
      <DiskDefragCompanion Include="$(MSBuildProjectDirectory)/../DiskDefrag/bin/$(Configuration)/net10.0-windows/DiskDefrag.runtimeconfig.dev.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DiskDefragCompanion)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Disk Defrag companion synced from ../DiskDefrag/bin/$(Configuration)." />
  </Target>

</Project>
